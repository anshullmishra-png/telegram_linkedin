# Telegram bot token from @BotFather. The bot must be an admin of Meera's channel.
TELEGRAM_BOT_TOKEN=

# Meera's own Telegram numeric user ID (message @userinfobot to get it).
# Only this user's private chat is used for the review flow.
MEERA_USER_ID=

# The channel Meera drops notes into. Numeric channel ID (starts with -100...),
# found e.g. by forwarding a channel message to @userinfobot, or from bot logs
# on first channel_post received (the app logs unrecognised chat ids at startup).
NOTES_CHANNEL_ID=

# Gemini API key (https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# Model used for scoring/cleaning/drafting/self-check. Keep this in one place
# so it can be swapped without touching code.
GEMINI_MODEL=gemini-flash-latest

# Model used to transcribe voice notes.
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe

# Path to the SQLite database file. Created on first run.
DB_PATH=data/skinstinct.db

# IANA timezone the twice-weekly batch runs in.
BATCH_TIMEZONE=Asia/Kolkata

# Batch run time, 24h HH:MM, local to BATCH_TIMEZONE.
BATCH_TIME=08:00

# --- Vercel webhook deployment (api/webhook.py) only ---
# These are NOT used by the long-polling bot (app/main.py) above and don't
# belong in this .env file for production - set them in Vercel's dashboard
# Environment Variables instead. See README.md's "Vercel webhook" section.
# TELEGRAM_WEBHOOK_SECRET=  (random string, e.g. `python3 -c "import secrets; print(secrets.token_urlsafe(32))"`)
# ALLOWED_CHAT_IDS=          (comma-separated: Meera's user id, her channel id)
# GEMINI_MODEL=gemini-flash-lite-latest   (webhook default is smaller/cheaper than the long-polling bot's)
# DB_PATH=/tmp/skinstinct.db  (NOT reliably persistent on Vercel - see README caveat)
# OUTBOUND_TIMEOUT_SECONDS=12
